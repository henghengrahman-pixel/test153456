      // Kemenangan/payout belum dibayar: kumpulkan ID + bukti/riwayat, lalu WAJIB Telegram.
      if(effective==='PAYOUT_NOT_RECEIVED' || wf?.workflow_type==='PAYOUT_CHECK'){
