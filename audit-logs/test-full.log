      return /^(?:(?:makasih|makasi|terima kasih|thanks|thank you|thx)(?:\s+(?:ya|yaa|bos|bosku|kak|min|admin))?|(?:oke|ok|siap|sip)\s+(?:makasih|makasi|terima kasih|thanks|thank you|thx)(?:\s+(?:ya|yaa|bos|bosku|kak|min|admin))?)[.!🙏😊👍❤️]*$/i.test(n);
    }
