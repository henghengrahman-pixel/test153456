          : `💸 CEK WITHDRAW\nID : ${uid}${extractOperationalAmount(ctx)?`\nNominal : Rp${extractOperationalAmount(ctx).toLocaleString('id-ID')}`:''}\n\ncek kepastian wd\n${all.slice(-500)}`;
