          if(!merged.proofUrl){
            return askAndTrack(livechat,chatId,'FORGOT_PASSWORD','RESET_PASSWORD','WAITING_DEPOSIT_PROOF',merged,'Boleh kirim bukti deposit verifikasinya ya bosku 🙏');
          }
          const result=await makeHumanRequest({
